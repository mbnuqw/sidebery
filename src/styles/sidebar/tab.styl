@import '../utils'

#root
  --tabs-pinned-height: 30px
  --tabs-pinned-width: 30px
  --tabs-margin: var(--general-margin)
  --tabs-padding: 2px
  --tabs-title-line-height: 20px
  --tabs-title-padding-top: 3px
  --tabs-title-padding-bottom: 3px
  --tabs-indent: 10px
  --tabs-font: rem(15) var(--general-font-family)
  --tabs-count-font: rem(9) var(--general-font-family)
  --tabs-badge-min-size: 6px
  --tabs-badge-value-padding: 0px 3px
  --tabs-badge-value-font: rem(8) var(--general-font-family)
  --tabs-border-radius: var(--general-border-radius)
  --tabs-close-btn-margin: 2px
  --tabs-audio-btn-size: 22px
  --tabs-normal-bg: var(--frame-el-bg)
  --tabs-normal-fg: var(--frame-fg)
  --tabs-activated-bg: var(--active-el-bg)
  --tabs-activated-fg: var(--active-el-fg)
  --tabs-activated-shadow: var(--active-el-shadow)
  --tabs-color-layer-opacity: .2
  --tabs-activated-color-layer-opacity: .3
  --tabs-discarded-favicon-opacity: .48
  --tabs-discarded-title-opacity: .56
#root[data-density="compact"]
  --tabs-pinned-height: 28px
  --tabs-pinned-width: 28px
  --tabs-title-line-height: 18px
  --tabs-indent: 8px
  --tabs-close-btn-margin: 1px
  --tabs-audio-btn-size: 20px
#root[data-density="loose"]
  --tabs-pinned-height: 32px
  --tabs-pinned-width: 32px
  --tabs-title-line-height: 22px
  --tabs-indent: 12px
  --tabs-close-btn-margin: 3px
#root[data-frame-color-scheme="dark"]
  --tabs-progress-bg: #ffffff16
  --tabs-lvl-opacity: .16
  --tabs-notification-badge-dot-bg: rgb(217, 83, 79)
  --tabs-notification-badge-count-bg: rgb(217, 83, 79)
  --tabs-notification-badge-count-fg: #ffffff
#root[data-frame-color-scheme="light"]
  --tabs-progress-bg: #00000016
  --tabs-lvl-opacity: .3
  --tabs-notification-badge-dot-bg: rgb(217, 83, 79)
  --tabs-notification-badge-count-bg: rgb(217, 83, 79)
  --tabs-notification-badge-count-fg: #ffffff

.Tab
  --tabs-title-padding-vert: calc(var(--tabs-title-padding-top) + var(--tabs-title-padding-bottom))
  --tabs-min-height: calc(var(--tabs-padding) * 2 + var(--tabs-title-line-height) + var(--tabs-title-padding-vert))
  --tabs-close-btn-max-width: calc(var(--tabs-min-height) - var(--tabs-close-btn-margin))
  --tabs-fav-margin: calc((var(--tabs-title-line-height) - 16px + var(--tabs-title-padding-vert)) / 2)

  position: relative
  contain: layout style
  width: calc(100% - var(--tabs-margin) * 2)
  margin: 0 var(--tabs-margin)
  padding-bottom: var(--tabs-margin)
  z-index: 10
  transition: transform var(--d-norm), opacity var(--d-fast), padding var(--d-fast), pointer-events var(--d-fast) linear allow-discrete

  // Set min-height for computational stuff
  min-height: var(--tabs-min-height)

  padding-left: calc(var(--tabs-indent) * 16)
  &[data-lvl="0"]
    padding-left: 0
  &[data-lvl="1"]
    padding-left: var(--tabs-indent)
  &[data-lvl="2"]
    padding-left: calc(var(--tabs-indent) * 2)
  &[data-lvl="3"]
    padding-left: calc(var(--tabs-indent) * 3)
  &[data-lvl="4"]
    padding-left: calc(var(--tabs-indent) * 4)
  &[data-lvl="5"]
    padding-left: calc(var(--tabs-indent) * 5)
  &[data-lvl="6"]
    padding-left: calc(var(--tabs-indent) * 6)
  &[data-lvl="7"]
    padding-left: calc(var(--tabs-indent) * 7)
  &[data-lvl="8"]
    padding-left: calc(var(--tabs-indent) * 8)
  &[data-lvl="9"]
    padding-left: calc(var(--tabs-indent) * 9)
  &[data-lvl="10"]
    padding-left: calc(var(--tabs-indent) * 10)
  &[data-lvl="11"]
    padding-left: calc(var(--tabs-indent) * 11)
  &[data-lvl="12"]
    padding-left: calc(var(--tabs-indent) * 12)
  &[data-lvl="13"]
    padding-left: calc(var(--tabs-indent) * 13)
  &[data-lvl="14"]
    padding-left: calc(var(--tabs-indent) * 14)
  &[data-lvl="15"]
    padding-left: calc(var(--tabs-indent) * 15)
  
  &[data-loading="true"]
    cursor: progress

  &[data-selected="true"]
  &[data-selected="true"]:hover
  &[data-selected="true"]:active
    z-index: 15
  
  &[data-edit="true"]
    z-index: 20
    padding-left: 0
    background-color: var(--frame-bg)

  &[data-discarded="true"] > .body .fav
    opacity: var(--tabs-discarded-favicon-opacity)
  &[data-discarded="true"] > .body .t-box
  &[data-discarded="true"] > .body .ctx
    opacity: var(--tabs-discarded-title-opacity)

  &[data-pin="true"]
    width: var(--tabs-pinned-width)
    height: var(--tabs-pinned-height)
    margin: 0
    padding: 0

  &[data-active="true"]
    z-index: 20

  &[data-active="true"]:has(+ .new-tab-btns)
    z-index: 30

.Tab.-hidden
  opacity: 0
  transform: translateY(-8px)

// ---
// -- Set outline for active colored tabs
// -
#root[data-frame-color-scheme="dark"] .Tab[data-colorized="true"]
  --tabs-activated-shadow: inset 0 0 0 1px #fff7,
                           0 1px 3px -1px #00000036
#root[data-frame-color-scheme="light"] .Tab[data-colorized="true"]
  --tabs-activated-shadow: inset 0 0 0 1px #0009,
                           0 1px 3px -1px #00000032

// ---
// -- Reset lvl in search mode
// -
#root[data-search="true"] .Tab
  padding-left: 0

// ---
// -- Body
// -
.Tab .body
  --tabs-indent-line-color: @css{color-mix(in srgb, var(--frame-bg) 85%, var(--frame-fg) 15%)}

  position: relative
  width: 100%
  min-height: var(--tabs-min-height)
  padding: var(--tabs-padding) 0 var(--tabs-padding) var(--tabs-padding)
  transition: opacity var(--d-fast), transform var(--d-fast)
  border-radius: var(--tabs-border-radius)
  background-color: var(--tabs-normal-bg)
  box-shadow: var(--frame-el-shadow)
  &:after
    content: ''
    position: absolute
    display: none
    top: calc(-4px - var(--tabs-margin))
    left: calc(var(--tabs-indent) / -2)
    width: 1px
    height: calc(100% + var(--tabs-margin))
    background-color: var(--tabs-indent-line-color)
  &:before
    content: ''
    position: absolute
    top: 0
    left: 0
    width: 100%
    height: 100%
    border-radius: var(--tabs-border-radius)
    z-index: 1

.Tab:hover .body:before
  background-color: var(--frame-el-overlay-hover-bg)

.Tab[data-active="true"] .body
  background-color: var(--tabs-activated-bg)
  box-shadow: var(--tabs-activated-shadow)
.Tab[data-active="true"]:hover .body:before
  background-color: initial

.Tab:active .body:before
  background-color: var(--frame-el-overlay-clicked-bg)

.Tab[data-selected="true"] .body:before
.Tab[data-selected="true"]:hover .body:before
.Tab[data-selected="true"]:active .body:before
  background-color: var(--frame-el-overlay-selected-bg)
  box-shadow: inset 0 0 0 1px var(--frame-el-overlay-selected-border)
.Tab[data-selected="true"][data-active="true"] .body:before
  box-shadow: inset 0 0 0 2px var(--frame-el-overlay-selected-border)
.Tab[data-locked-selection="true"] .body:before
.Tab[data-locked-selection="true"]:hover .body:before
.Tab[data-locked-selection="true"]:active .body:before
  outline: 2px dashed var(--frame-el-overlay-selected-border)
  outline-offset: -2px
.Tab[data-locked-selection="true"][data-selected="true"] .body:before
  box-shadow: inset 0 0 0 2px var(--frame-el-overlay-selected-border)
.Tab[data-selected="true"][data-locked-selection="true"][data-active="true"] .body:before
  box-shadow: inset 0 0 0 3px var(--frame-el-overlay-selected-border)

.Tab[data-edit="true"] .body:before
  background-color: var(--frame-el-overlay-selected-bg)
  box-shadow: inset 0 0 0 1px var(--frame-el-overlay-selected-border)
.Tab[data-edit="true"][data-active="true"] .body:before
  box-shadow: inset 0 0 0 2px var(--frame-el-overlay-selected-border)

.Tab[data-pin="true"] .body
  width: 100%
  height: 100%
  padding: var(--tabs-padding)
  left: 0

#root[data-tabs-tree-lvl-marks="true"] .Tab[data-pin="false"]:not([data-lvl="0"]) .body:after
  display: block
  box-shadow: calc(var(--tabs-indent) * -1) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -2) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -3) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -4) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -5) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -6) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -7) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -8) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -9) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -10) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -11) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -12) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -13) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -14) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -15) 0 0 0 var(--tabs-indent-line-color),
              calc(var(--tabs-indent) * -16) 0 0 0 var(--tabs-indent-line-color)
.Tab[data-parent="true"][data-folded="false"] + .Tab .body:after
.Tab[data-edit="true"] + .Tab .body:after
  background-color: transparent
  background-image: linear-gradient(180deg, transparent 0, transparent 5px, var(--tabs-indent-line-color) 5px, var(--tabs-indent-line-color))

// ---
// -- Color layer
// -
.Tab .color-layer
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  border-radius: var(--tabs-border-radius)
  background-color: var(--tab-color)
  opacity: var(--tabs-color-layer-opacity)
.Tab[data-active="true"] .color-layer
  opacity: var(--tabs-activated-color-layer-opacity)
.Tab[data-active="false"] .color-layer
  box-shadow: 0 0 2px 0 #0007
#root[data-frame-color-scheme="light"] .Tab .color-layer
  opacity: calc(var(--tabs-color-layer-opacity) + .16)
#root[data-frame-color-scheme="light"] .Tab[data-active="true"] .color-layer
  opacity: calc(var(--tabs-activated-color-layer-opacity) + .2)
#root[data-frame-color-scheme="light"] .Tab[data-active="false"] .color-layer
  box-shadow: inset 0 0 0 1px #0003
.Tab[data-named-domain-group="true"] .color-layer
  opacity: .42
  box-shadow: inset 0 0 0 1px var(--tab-color), 0 0 2px 0 #0007
.Tab[data-named-domain-group="true"][data-active="true"] .color-layer
  opacity: .55
#root[data-frame-color-scheme="light"] .Tab[data-named-domain-group="true"] .color-layer
  opacity: .50
#root[data-frame-color-scheme="light"] .Tab[data-named-domain-group="true"][data-active="true"] .color-layer
  opacity: .62
.Tab[data-named-domain-group="true"] .title
  font-weight: 600

// ---
// -- Flash animation
// -
.Tab .flash-fx
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  border-radius: var(--tabs-border-radius)
  overflow: clip
  opacity: 0
  &:before
    content: ''
    position: absolute
    width: 100%
    height: 100%
    top: 0
    left: 0
    background-image: linear-gradient(90deg, #00000000, var(--tabs-normal-fg))
    transform: translateX(-100%)
.Tab[data-active="true"] .flash-fx:before
  background-image: linear-gradient(90deg, #00000000, var(--tabs-activated-fg))
.Tab .flash-fx[data-run="true"]
  animation: flash-box-animation .4s
  &:before
    animation: flash-progress-animation .4s

// ---
// -- Unread mark
// -
.Tab .unread-mark
  position: absolute
  left: 0
  bottom: 0
  width: 6px
  height: 6px
  border-bottom-left-radius: 2px
  overflow: clip
  &:before
    content: ''
    position: absolute
    top: 0
    left: 0
    width: 12px
    height: 10px
    transform: rotateZ(45deg)
    transform-origin: 0 0
    background-color: var(--tabs-normal-fg)

// ---
// -- Main row
// -
.Tab .main-row
  position: relative
  width: 100%
.Tab[data-pin="true"] .main-row
  height: 100%

// ---
// -- Favicon
// -
.Tab .fav
  width: 16px
  height: 16px
  transform: translateZ(0)
.Tab[data-pin="false"] .fav
  position: absolute
  margin: var(--tabs-fav-margin) 0 var(--tabs-fav-margin) var(--tabs-fav-margin)
  z-index: 20
  // &:before
  //   content: ''
  //   position: absolute
  //   top: 1px
  //   left: calc(3px - (var(--tabs-min-height) - 16px) / 2)
  //   width: 2px
  //   height: 14px
  //   background-color: var(--color)
.Tab[data-pin="true"] .fav
  position: absolute
  top: calc(50% - 8px)
  left: calc(50% - 8px)
  z-index: 10
//   &:before
//     content: ''
//     position: absolute
//     bottom: calc(3px - (var(--tabs-min-height) - 16px) / 2)
//     left: 1px
//     width: 14px
//     height: 2px
//     background-color: var(--color)
// .Tab[data-pin="true"][data-loading="true"] .fav:before
//   width: 5px

.Tab .fav-icon
  position: absolute
  top: 0
  left: 0
  width: 16px
  height: 16px
  fill: var(--tabs-normal-fg)
  transition: opacity var(--d-fast)
.Tab img.fav-icon
  display: none

.Tab .fav svg
  opacity: .8

.Tab[data-active="true"] .fav-icon
  fill: var(--tabs-activated-fg)

#root[data-search="false"] .Tab[data-parent="true"] .fav:hover svg.fav-icon
#root[data-search="false"] .Tab[data-parent="true"][data-folded="true"] .fav svg.fav-icon
  opacity: .2

#root[data-search="false"] .Tab[data-parent="true"] .fav:hover img
#root[data-search="false"] .Tab[data-parent="true"][data-folded="true"] .fav img
  opacity: .2

.Tab[data-updated="true"] .fav-icon
.Tab[data-pending="true"] .fav-icon
.Tab[data-loading="ok"] .fav-icon
.Tab[data-loading="err"] .fav-icon
  mask: radial-gradient(
    circle at calc(100% - 2px) calc(100% - 2px),
    #00000024,
    #00000024 4px,
    #000000 5px,
    #000000
  )

.Tab[data-loading="true"] .fav-icon
  mask: radial-gradient(
    circle at calc(100% - 2px) calc(100% - 2px),
    #00000024,
    #00000024 7px,
    #000000 8px,
    #000000
  )

// ---
// -- Tabs group expand icon
// -
.Tab .exp
  position: absolute
  width: calc(100% + 8px)
  height: calc(100% + 8px)
  top: -4px
  left: -4px
  opacity: 0
  z-index: -1
  cursor: pointer
  transition: opacity var(--d-fast), transform var(--d-fast)
.Tab .exp-icon
  position: absolute
  top: 4px
  left: 4px
  width: 16px
  height: 16px
  fill: var(--tabs-normal-fg)
.Tab[data-active="true"] .exp-icon
  fill: var(--tabs-activated-fg)

.Tab[data-parent="true"] .fav:hover .exp
  z-index: 1
  opacity: 1

#root[data-search="false"] .Tab[data-parent="true"][data-folded="true"] .fav .exp
  z-index: 1
  opacity: 1
  transform: rotateZ(-90deg)

.Tab[data-urgent-descendant="true"] .fav .exp:before
  content: ''
  position: absolute
  left: 9px
  top: 9px
  width: 6px
  height: 6px
  background-color: var(--badge-urgent-bg)
  box-shadow: 0 0 0 1px var(--frame-bg)
  opacity: 0
  clip-path: polygon(0% 0, 100% 0, 50% 50%)
  transition: opacity var(--d-fast)

.Tab[data-folded="true"] .fav .exp:before
  opacity: 1

// ---
// -- Domain trees solid favicon & hover expand arrow
// -
#root .Tab[data-domain-group="true"] .fav img
#root .Tab[data-domain-group="true"] .fav svg.fav-icon
  opacity: 1 !important

#root[data-search="false"] .Tab[data-domain-group="true"][data-parent="true"][data-folded="true"] .fav .exp
  opacity: 0
  pointer-events: none
  transform: rotateZ(-90deg)

#root .Tab[data-domain-group="true"][data-parent="true"] .fav:hover .exp
#root[data-search="false"] .Tab[data-domain-group="true"][data-parent="true"][data-folded="true"] .fav:hover .exp
  opacity: 1
  z-index: 2
  pointer-events: auto
  background-color: var(--frame-bg)
  border-radius: 4px
  box-shadow: 0 0 3px 0 #0008

// ---
// -- Progress spinner
// -
.Tab .progress-spinner
  position: absolute
  visibility: hidden
  box-sizing: border-box
  width: 12px
  height: 12px
  right: -4px
  bottom: -4px
  border-radius: 50%
  border-top: 2px solid var(--tabs-normal-fg)
  border-left: 2px solid var(--tabs-progress-bg)
  border-right: 2px solid var(--tabs-progress-bg)
  border-bottom: 2px solid var(--tabs-progress-bg)
.Tab[data-active="true"] .progress-spinner
  border-top: 2px solid var(--tabs-activated-fg)

#root[data-animations="none"]
  .Tab .progress-spinner
    border-radius: 0
    border: none
    animation: none
    fill: var(--tabs-normal-fg)

.Tab[data-loading="true"] .progress-spinner
  visibility: visible
  animation: rotating-animation .5s infinite linear

// ---
// -- Badge
// -
.Tab .badge
  position: absolute
  min-height: var(--tabs-badge-min-size)
  min-width: var(--tabs-badge-min-size)
  right: 0
  top: 0
  font: var(--tabs-badge-value-font)
  line-height: 1.6
  color: var(--fg, var(--badge-fg))
  background-color: var(--bg, var(--badge-bg))
  padding: var(--tabs-badge-value-padding)
  border-radius: 9999px
  box-shadow: 0 0 0 1px var(--frame-bg)
  transform: translate(50%, -50%)
  z-index: 1
  pointer-events: none
  white-space: nowrap
  &[data-urgent="true"]
    color: var(--fg, var(--badge-urgent-fg))
    background-color: var(--bg, var(--badge-urgent-bg))

.Tab[data-pin="true"] .badge
  max-width: calc(100% + 8px)
  text-overflow: ellipsis
  overflow: clip
  transform: translate(3px, -50%)

.Tab[data-pin="true"][data-audible="true"] .badge
.Tab[data-pin="true"][data-muted="true"] .badge
.Tab[data-pin="true"][data-paused="true"] .badge
  display: none

// ---
// -- Pending mark
// -
.Tab .pending-mark
  position: absolute
  width: 6px
  height: 6px
  right: -1px
  bottom: -1px
  border-radius: 50%
  background-color: var(--tabs-normal-fg)
  opacity: 0
  transition: opacity var(--d-norm)
.Tab[data-loading="false"][data-pending="true"] .pending-mark
  opacity: 1

// ---
// -- Count of descendants
// -
.Tab .child-count
  position: absolute
  width: 8px
  right: -2px
  bottom: -6px
  font: var(--tabs-count-font)
  text-align: center
  color: var(--tabs-normal-fg)
.Tab[data-active="true"] .child-count
  color: var(--tabs-activated-fg)

#root[data-search="true"] .Tab .child-count
.Tab[data-loading="true"] .child-count
.Tab[data-pending="true"] .child-count
  opacity: 0

// ---
// -- Audio
// -
#root .Tab
  --tabs-pinned-audio-btn-width: 16px
  --tabs-pinned-audio-btn-height: 16px
#root[data-density="compact"] .Tab
  --tabs-pinned-audio-btn-width: 14px
  --tabs-pinned-audio-btn-height: 14px

.Tab .audio
  --between-fg-and-bg: @css{color-mix(in srgb, var(--frame-bg) 50%, var(--frame-fg) 50%)}

  position: absolute
  z-index: 21

.Tab[data-pin="false"] .audio:hover:before
  content: ''
  position: absolute
  width: calc(var(--tabs-audio-btn-size) - 4px)
  height: calc(var(--tabs-audio-btn-size) - 4px)
  top: 2px
  left: 2px
  border-radius: var(--tabs-border-radius)
  background-color: var(--tabs-activated-fg)
  opacity: .12

.Tab[data-pin="true"] .audio:hover:before
  content: ''
  position: absolute
  width: var(--tabs-pinned-audio-btn-width)
  height: var(--tabs-pinned-audio-btn-width)
  top: 0
  left: 0
  border-radius: calc(var(--tabs-border-radius) - 1px)
  background-color: var(--tabs-activated-fg)
  opacity: .12

.Tab .audio-icon
  position: absolute
  top: calc(50% - 6px)
  left: calc(50% - 6px)
  width: 12px
  height: 12px
  fill: var(--tabs-normal-fg)
  transition: opacity var(--d-fast)
  opacity: 0

.Tab[data-pin="false"][data-active="true"] .audio-icon
  fill: var(--tabs-activated-fg)

.Tab[data-pin="false"] .audio
  top: calc((var(--tabs-title-line-height) + var(--tabs-title-padding-vert) - var(--tabs-audio-btn-size)) / 2)
  margin-left: calc(16px + var(--tabs-fav-margin))
  width: var(--tabs-audio-btn-size)
  height: var(--tabs-audio-btn-size)
  animation: appearing-animation var(--d-norm)
.Tab[data-pin="true"] .audio
  top: 0
  right: 0
  width: var(--tabs-pinned-audio-btn-width)
  height: var(--tabs-pinned-audio-btn-height)
  border-radius: calc(var(--tabs-border-radius) - 1px)
  background-color: var(--frame-bg)
  box-shadow: inset 0 0 0 1px var(--between-fg-and-bg)

.Tab[data-audible="true"]:not([data-muted="true"]):not([data-paused="true"]) svg.-loud
.Tab[data-muted="true"]:not([data-paused="true"]) svg.-mute
.Tab[data-paused="true"] svg.-pause
  opacity: 1

// ---
// -- Title box
// -
.Tab .t-box
  --tabs-title-indent: calc(15px + var(--tabs-fav-margin) + var(--tabs-padding))
  --tabs-title-indent-audio: calc(15px + var(--tabs-audio-btn-size))
  --tabs-title-max-height: calc(var(--tabs-title-line-height) * var(--tabs-title-lines-max) + var(--tabs-title-padding-vert))
  --tabs-title-multiline-right-padding: calc(var(--tabs-padding) + var(--tabs-fav-margin))

  position: relative
  width: 100%
  margin: 0
  max-height: var(--tabs-title-max-height)
  overflow: clip
  z-index: 1
  mask-image: linear-gradient(-90deg, transparent, transparent 2px, #000 10px, #000)
  mask-repeat: no-repeat

#root[data-tabs-close-btn="always"] .Tab .t-box
#root[data-tabs-close-btn="hover"] .Tab:hover .t-box
#root[data-tabs-multiline-title="true"] .TabList > .Tab:hover .t-box
  mask-image: linear-gradient(-90deg, transparent, transparent var(--tabs-min-height), #000 calc(var(--tabs-min-height) + 12px), #000)

#root[data-tabs-multiline-title="true"] .TabList > .Tab .t-box
#root .TabList > .Tab[data-edit="true"] .t-box
#root .TabList > .Tab[data-edit="true"]:hover .t-box
  mask-image: none

#root[data-tabs-close-btn="always"] .Tab .t-box
  padding-right: var(--tabs-close-btn-max-width)

// ---
// -- Custom title input
// -
.Tab .custom-title-input
  position: relative
  display: block
  font: var(--tabs-font)
  line-height: var(--tabs-title-line-height)
  color: var(--tabs-normal-fg)
  background-color: transparent
  appearance: none
  border: none
.Tab input.custom-title-input
  width: 100%
  margin: 0
  padding: var(--tabs-title-padding-top) 2px var(--tabs-title-padding-bottom) calc(var(--tabs-fav-margin) + var(--tabs-title-indent))
.Tab textarea.custom-title-input
  margin: 0
  padding: var(--tabs-title-padding-top) var(--tabs-title-multiline-right-padding) var(--tabs-title-padding-bottom) var(--tabs-fav-margin)
  field-sizing: content
  min-height: unset
  max-height: var(--tabs-title-max-height)
  text-indent: var(--tabs-title-indent)
  scroll-padding-top: var(--tabs-title-padding-top)
  scroll-padding-bottom: var(--tabs-title-padding-bottom)
  resize: none
  scrollbar-width: none
#root[data-tabs-title-br="w"] textarea.custom-title-input
  word-break: break-word
#root[data-tabs-title-br="c"] textarea.custom-title-input
  word-break: break-all

.Tab[data-audible="true"] .t-box input.custom-title-input
.Tab[data-muted="true"] .t-box input.custom-title-input
.Tab[data-paused="true"] .t-box input.custom-title-input
  margin: 0 0 0 var(--tabs-title-indent-audio)
  width: calc(100% - var(--tabs-title-indent-audio))
.Tab[data-audible="true"] .t-box textarea.custom-title-input
.Tab[data-muted="true"] .t-box textarea.custom-title-input
.Tab[data-paused="true"] .t-box textarea.custom-title-input
  text-indent: var(--tabs-title-indent-audio)
.Tab.-mlttadown .fav
.Tab.-mlttadown .audio
  opacity: 0

// ---
// -- Title
// -
.Tab .title
  position: relative
  font: var(--tabs-font)
  color: var(--tabs-normal-fg)
  padding: var(--tabs-title-padding-top) 0 var(--tabs-title-padding-bottom) var(--tabs-fav-margin)
  line-height: var(--tabs-title-line-height)
  max-height: var(--tabs-title-max-height)
  overflow: clip
  white-space: nowrap
  text-indent: var(--tabs-title-indent)
  transition: transform var(--d-fast)
#root[data-tabs-multiline-title="true"] .TabList > .Tab .title
  display: -webkit-box
  white-space: wrap
  padding: var(--tabs-title-padding-top) var(--tabs-title-multiline-right-padding) var(--tabs-title-padding-bottom) var(--tabs-fav-margin)
  -webkit-line-clamp: var(--tabs-title-lines-max)
  -webkit-box-orient: vertical
#root[data-tabs-title-br="w"] .Tab .title
  word-break: break-word
#root[data-tabs-title-br="c"] .Tab .title
  word-break: break-all

.Tab[data-audible="true"] .t-box .title
.Tab[data-muted="true"] .t-box .title
.Tab[data-paused="true"] .t-box .title
  text-indent: var(--tabs-title-indent-audio)

.Tab[data-active="true"] .title
  color: var(--tabs-activated-fg)

#root .Tab[data-edit="true"] .body .t-box .title
  display: none

// ---
// -- Close button
// -
.Tab .close
  position: absolute
  top: var(--tabs-close-btn-margin)
  right: var(--tabs-close-btn-margin)
  height: calc(100% - var(--tabs-close-btn-margin) * 2)
  aspect-ratio: 1 / 1
  max-width: var(--tabs-close-btn-max-width)
  z-index: 20
  opacity: 0
  border-radius: calc(var(--tabs-border-radius) - var(--tabs-close-btn-margin))
  &:hover
    background-color: var(--frame-el-overlay-hover-bg)
  &:active
    background-color: var(--frame-el-overlay-clicked-bg)

.Tab[data-active="true"] .close
  &:hover
    background-color: var(--active-el-overlay-hover-bg)
  &:active
    background-color: var(--active-el-overlay-clicked-bg)

.Tab .close-icon
  position: absolute
  top: calc(50% - 9px)
  left: calc(50% - 9px)
  width: 18px
  height: 18px
  fill: var(--tabs-normal-fg)
  opacity: .7

.Tab[data-active="true"] .close-icon
  fill: var(--tabs-activated-fg)

#root[data-tabs-close-btn="always"] .Tab .close
#root[data-tabs-close-btn="hover"] .Tab:hover .close
  opacity: 1

.Tab[data-edit="true"] .close
  display: none

// ---
// -- Container highlight
// -
.Tab .ctx
  position: absolute
  pointer-events: none
  background-color: var(--color)
.Tab[data-pin="false"] .ctx
  top: var(--tabs-border-radius)
  right: 0
  width: 2px
  height: calc(100% - var(--tabs-border-radius) * 2)
#root[data-pinned-tabs-position="panel"] .Tab[data-pin="true"] .ctx
#root[data-pinned-tabs-position="top"] .Tab[data-pin="true"] .ctx
  bottom: 1px
  left: calc(50% - 8px)
  width: 16px
  height: 2px
#root[data-pinned-tabs-position="panel"] .Tab[data-pin="true"][data-loading="true"] .ctx
#root[data-pinned-tabs-position="top"] .Tab[data-pin="true"][data-loading="true"] .ctx
  width: 7px
#root[data-pinned-tabs-position="right"] .Tab[data-pin="true"] .ctx
  top: calc(50% - 8px)
  right: 0
  width: 2px
  height: 16px
#root[data-pinned-tabs-position="left"] .Tab[data-pin="true"] .ctx
  top: calc(50% - 8px)
  left: 0
  width: 2px
  height: 16px

// ---
// -- Keyframes
// -
@keyframes appearing-animation
  0%
    opacity: 0
  100%
    opacity: 1

@keyframes flash-box-animation
  0%
    opacity: .8
  100%
    opacity: 0

@keyframes flash-progress-animation
  0%
    transform: translateX(-100%)
  100%
    transform: translateX(5px)
