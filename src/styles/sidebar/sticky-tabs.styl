@import '../utils'

.StickyTabs
  left: 0
  width: 100%
  height: 0
.StickyTabs.-top
  position: sticky
  top: 0
  height: 0
  z-index: 1000
.StickyTabs.-bottom
  position: absolute
  bottom: 100%
  display: flex
  flex-direction: column
  justify-content: flex-end
.TabsPanel > .StickyTabs.-bottom
  position: relative
  bottom: auto
  z-index: 1000

// Hidden state
.StickyTabs[data-hide="true"]
  pointer-events: none
  opacity: 0
  transition: opacity var(--d-fast)

// Tabs container
.StickyTabs > .sticky-box
  position: absolute
  width: 100%
  left: 0
  background-color: var(--frame-bg)
.StickyTabs.-top > .sticky-box
  padding-bottom: 1px
.StickyTabs.-bottom > .sticky-box
  padding-top: calc(var(--tabs-margin) + 1px)
#root[data-sticky-tabs-layout="row"] .StickyTabs > .sticky-box
  display: flex
  justify-content: flex-end

// Visual separator and shadow
.StickyTabs > .sticky-box:before
  content: ''
  position: absolute
  left: 0
  width: 100%
  height: 1px
  opacity: .5
  background-image: linear-gradient(90deg, transparent, #fff, #fff, transparent)
.StickyTabs.-top > .sticky-box
  box-shadow: 0 1px 0 0 #00000012, 0 10px 10px -10px #00000068
  &:before
    bottom: 0
.StickyTabs.-bottom > .sticky-box
  box-shadow: 0 -1px 0 0 #00000012, 0 -10px 10px -10px #00000068
  &:before
    top: 0

// Sticky tabs
.StickyTabs .Tab
  z-index: 1000
  padding-left: 0
  transition: transform var(--d-fast), display var(--d-fast) allow-discrete

// Starting style for appearing animation
@css{
  @starting-style {
    .StickyTabs .Tab[data-lvl="0"] {
      transform: translateX(0);
    }
    .StickyTabs .Tab[data-lvl="1"] {
      transform: translateX(var(--tabs-indent));
    }
    .StickyTabs .Tab[data-lvl="2"] {
      transform: translateX(calc(var(--tabs-indent) * 2));
    }
    .StickyTabs .Tab[data-lvl="3"] {
      transform: translateX(calc(var(--tabs-indent) * 3));
    }
    .StickyTabs .Tab[data-lvl="4"] {
      transform: translateX(calc(var(--tabs-indent) * 4));
    }
    .StickyTabs .Tab[data-lvl="5"] {
      transform: translateX(calc(var(--tabs-indent) * 5));
    }
    .StickyTabs .Tab[data-lvl="6"] {
      transform: translateX(calc(var(--tabs-indent) * 6));
    }
    .StickyTabs .Tab[data-lvl="7"] {
      transform: translateX(calc(var(--tabs-indent) * 7));
    }
    .StickyTabs .Tab {
      transform: translateX(calc(var(--tabs-indent) * 8));
    }
  }
  @starting-style {
    #root[data-sticky-tabs-layout="row"] .StickyTabs.-bottom .Tab {
      transform: translateX(-16px);
    }
  }
}

#root[data-sticky-tabs-layout="col"] .StickyTabs .Tab
  flex-shrink: 0

#root[data-sticky-tabs-layout="row"] .StickyTabs .Tab
  flex-shrink: 1

// Don't show indent indicators
#root .StickyTabs .sticky-box .Tab[data-lvl] > .body:after
  display: none

#root[data-sticky-tabs-layout="row"] .StickyTabs .Tab:not(:last-of-type)
  margin-right: 0
  max-width: var(--tabs-height)
  min-width: var(--tabs-height)
  .close
  .exp
  .t-box
    display: none
  .dnd-layer
    z-index: 21
  &[data-audible="true"]
  &[data-muted="true"]
  &[data-paused="true"]
    max-width: calc(var(--tabs-height) + 16px)

#root[data-sticky-tabs-layout="row"] .StickyTabs .Tab:last-of-type
  min-width: calc(var(--tabs-height) * 2)
