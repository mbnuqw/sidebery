@import '../utils'

#root[data-frame-color-scheme="dark"] .PinnedTabsBar
  --sep-opacity: .16
#root[data-frame-color-scheme="light"] .PinnedTabsBar
  --sep-opacity: .3

.PinnedTabsBar
  position: relative
  display: flex
  background-color: var(--frame-bg)
  transition: padding var(--d-fast)
  &[data-empty="true"]
    display: none

// Per-Panel
#root[data-pinned-tabs-position="panel"] .PinnedTabsBar
  width: 100%
  height: auto
  flex-wrap: wrap
  flex-direction: row
  grid-gap: var(--tabs-margin)
  padding: 0 var(--tabs-margin) var(--tabs-margin)

#root[data-pinned-tabs-position="panel"][data-pinned-tabs-list="true"] .PinnedTabsBar
  padding: 0 0 calc(var(--tabs-margin) + 9px)
  grid-gap: 0

// Left/Right
#root[data-pinned-tabs-position="left"] .PinnedTabsBar
#root[data-pinned-tabs-position="right"] .PinnedTabsBar
  width: 100%
  height: 100%
  align-items: center
  flex-shrink: 0
  flex-grow: 0
  flex-direction: column
  grid-gap: var(--tabs-margin)

#root[data-pinned-tabs-position="left"]:not([data-nav-layout="horizontal"]) .PinnedTabsBar
#root[data-pinned-tabs-position="right"]:not([data-nav-layout="horizontal"]) .PinnedTabsBar
  padding: calc(var(--general-margin) - var(--s-darker-border-width, 0px)) 0 var(--tabs-margin)
  
// Left/Right stacked with navbar
#root[data-pinned-tabs-position="left"][data-nav-layout="left"] .PinnedTabsBar
#root[data-pinned-tabs-position="right"][data-nav-layout="right"] .PinnedTabsBar
  height: auto
#root[data-pinned-tabs-position="left"][data-nav-layout="left"][data-drag="true"] .PinnedTabsBar
#root[data-pinned-tabs-position="right"][data-nav-layout="right"][data-drag="true"] .PinnedTabsBar
  padding: calc(var(--general-margin) - var(--s-darker-border-width, 0px)) 0 16px

// Top
#root[data-pinned-tabs-position="top"] .PinnedTabsBar
  width: 100%
  height: auto
  flex-wrap: wrap
  flex-direction: row
  grid-gap: var(--tabs-margin)
  padding: 0 var(--tabs-margin) var(--tabs-margin)

#root[data-pinned-tabs-position="top"][data-pinned-tabs-list="true"] .PinnedTabsBar
  padding: 0 0 calc(var(--tabs-margin) + 9px)
  grid-gap: 0

// ---
// -- Separator
// -
.PinnedTabsBar:after
  content: ''
  position: absolute
  display: none
  bottom: calc(var(--tabs-margin) + 4px)
  left: var(--tabs-margin)
  width: calc(100% - var(--tabs-margin) * 2)
  height: 1px
  opacity: var(--sep-opacity)
  background-image: linear-gradient(90deg, transparent, var(--frame-fg) 10%, var(--frame-fg) 90%, transparent)

// Not shown in capped mode: an absolutely-positioned child of a scroll
// container scrolls with its content, so it would sit over the last visible
// row at scrollTop:0 and slide away as you scroll - capped mode uses the
// edge fade below instead.
#root[data-pinned-tabs-position="panel"][data-pinned-tabs-list="true"]:not([data-pinned-tabs-list-capped="true"]) .PinnedTabsBar:after
  display: block

#root[data-pinned-tabs-position="top"][data-pinned-tabs-list="true"]:not([data-pinned-tabs-list-capped="true"]) .PinnedTabsBar:after
  display: block

// ---
// -- Tab wrapper
// -
.PinnedTabsBar .tab-wrapper
  position: relative
  &:before
    content: ''
    position: absolute
    top: calc(var(--tabs-margin) * -1)
    left: calc(var(--tabs-margin) * -1)
    width: calc(100% + var(--tabs-margin))
    height: calc(100% + var(--tabs-margin))
  &:after
    content: ''
    position: absolute
    display: none
    top: 0
    left: -2px
    width: 2px
    height: 100%
    z-index: 2000
    background-color: var(--s-accent, var(--frame-el-overlay-selected-border))
    pointer-events: none
    border-radius: 4px
    box-shadow: 0 0 0 1px var(--frame-bg)
  &[data-targeted="true"]:after
    display: block

#root[data-pinned-tabs-position="panel"][data-pinned-tabs-list="true"] .PinnedTabsBar .tab-wrapper
#root[data-pinned-tabs-position="top"][data-pinned-tabs-list="true"] .PinnedTabsBar .tab-wrapper
  width: 100%

#root[data-pinned-tabs-position="panel"][data-pinned-tabs-list="true"] .PinnedTabsBar .tab-wrapper:after
#root[data-pinned-tabs-position="top"][data-pinned-tabs-list="true"] .PinnedTabsBar .tab-wrapper:after
  top: 0
  left: 0
  width: 100%
  height: 2px

#root[data-pinned-tabs-position="left"] .PinnedTabsBar .tab-wrapper:after
#root[data-pinned-tabs-position="right"] .PinnedTabsBar .tab-wrapper:after
  top: -2px
  left: 0
  width: 100%
  height: 2px

#root[data-drag="true"] .PinnedTabsBar[data-dnd-end="true"] .tab-wrapper:last-of-type:after
  display: block
  left: auto
  right: -2px
#root[data-pinned-tabs-position="panel"][data-pinned-tabs-list="true"]
#root[data-pinned-tabs-position="top"][data-pinned-tabs-list="true"]
#root[data-pinned-tabs-position="left"]
#root[data-pinned-tabs-position="right"]
  .PinnedTabsBar[data-dnd-end="true"] .tab-wrapper:last-of-type:after
    display: block
    left: auto
    right: auto
    top: auto
    bottom: 0

// ---
// -- Single-line scrolling (panel/top, behind the setting) and
// -- always-scrolling (left/right, which never wrapped and used to just
// -- clip overflowing pins)
// -
// Gating on [data-pinned-tabs-list="false"] matters: .PinnedTabsBar:after
// (the list-mode separator, above) and the full-width .tab-wrapper it implies
// are absolutely-positioned/sized for a wrapping list and must never become
// part of a horizontal scroller.
#root[data-pinned-tabs-position="panel"][data-pinned-tabs-single-line="true"][data-pinned-tabs-list="false"] .PinnedTabsBar
#root[data-pinned-tabs-position="top"][data-pinned-tabs-single-line="true"][data-pinned-tabs-list="false"] .PinnedTabsBar
  flex-wrap: nowrap
  overflow-x: auto
  overflow-y: hidden
  // The bar is a column-flex child sibling to a height:100% ScrollBox/
  // .panel-box, so the flex line is always over-constrained; overflow:auto
  // already zeroes this element's automatic minimum size, so without an
  // explicit flex-shrink:0 it gets squeezed a few px short of
  // --tabs-pinned-height.
  flex-shrink: 0
  scrollbar-width: none
  overscroll-behavior: contain
  .tab-wrapper
    flex-shrink: 0

#root[data-pinned-tabs-position="left"] .PinnedTabsBar
#root[data-pinned-tabs-position="right"] .PinnedTabsBar
  // clip, not hidden: the pinned badge overflows a few px past the tab's
  // right edge (see below) and must not create a phantom horizontal
  // scroll range
  overflow-x: clip
  overflow-y: auto
  scrollbar-width: none
  overscroll-behavior: contain
  .tab-wrapper
    flex-shrink: 0

// Capped titled list: the list still wraps into full-width rows, but is now
// height-limited to N rows and scrolls instead of growing forever.
//
// The 3-attribute selector (position + list + capped) isn't logically
// necessary - [data-pinned-tabs-list-capped="true"] alone already implies
// panel/top + list - it's there purely so this rule's specificity beats the
// list-mode padding rule above (bar.pinned-tabs.styl:25-27 / 61-63).
#root[data-pinned-tabs-position="panel"][data-pinned-tabs-list="true"][data-pinned-tabs-list-capped="true"] .PinnedTabsBar
#root[data-pinned-tabs-position="top"][data-pinned-tabs-list="true"][data-pinned-tabs-list-capped="true"] .PinnedTabsBar
  // one titled row = .Tab's min-height + its own bottom padding (tab.styl)
  max-height: calc(var(--pinned-list-max-rows) * (var(--tabs-min-height) + var(--tabs-margin)))
  // the list-mode separator's reserved space must live OUTSIDE the scroll
  // box (border-box sizing would otherwise count it against max-height, and
  // as padding it would also show up as dead scrollable space at the end)
  padding-bottom: 0
  margin-bottom: calc(var(--tabs-margin) + 9px)
  overflow-x: clip
  overflow-y: auto
  // see the flex-shrink comment on the single-line rule above - same issue
  flex-shrink: 0
  scrollbar-width: none
  overscroll-behavior: contain
  .tab-wrapper
    flex-shrink: 0

// Stacked with the nav bar on the same side, the bar is height:auto with
// flex-shrink:0 (above), so it would just grow past .left-vertical-box and
// get clipped by #root{overflow:clip} instead of scrolling itself. Let it
// yield so its own overflow engages and the nav bar keeps the rest.
#root[data-pinned-tabs-position="left"][data-nav-layout="left"] .PinnedTabsBar
#root[data-pinned-tabs-position="right"][data-nav-layout="right"] .PinnedTabsBar
  min-height: 0
  flex-shrink: 1

// The badge normally overflows ~7px above and up to 11px right of the tab
// (tab.styl:519-523); overflow-x:clip above would cut the right side off
// a vertical pinned bar, so tuck it fully inside the tab box there.
#root[data-pinned-tabs-position="left"] .PinnedTabsBar .Tab[data-pin="true"] .badge
#root[data-pinned-tabs-position="right"] .PinnedTabsBar .Tab[data-pin="true"] .badge
  max-width: 100%
  transform: translate(0, -50%)

// ---
// -- Edge fade affordance
// -- The mask is painted in the element's own border box, so unlike an
// -- absolutely positioned pseudo-element it does not scroll with the
// -- content. Disabled while dragging so it never dims the 2px
// -- .tab-wrapper:after insert indicators near the edges.
// -
.PinnedTabsBar
  --pt-fade: 20px

#root:not([data-drag="true"]) .PinnedTabsBar[data-overflow="start"]
  mask-image: linear-gradient(90deg, transparent 0, #000 var(--pt-fade), #000 100%)
#root:not([data-drag="true"]) .PinnedTabsBar[data-overflow="end"]
  mask-image: linear-gradient(90deg, #000 0, #000 calc(100% - var(--pt-fade)), transparent 100%)
#root:not([data-drag="true"]) .PinnedTabsBar[data-overflow="both"]
  mask-image: linear-gradient(90deg, transparent 0, #000 var(--pt-fade), #000 calc(100% - var(--pt-fade)), transparent 100%)

#root[data-pinned-tabs-position="left"]:not([data-drag="true"]) .PinnedTabsBar[data-overflow="start"]
#root[data-pinned-tabs-position="right"]:not([data-drag="true"]) .PinnedTabsBar[data-overflow="start"]
#root[data-pinned-tabs-list-capped="true"]:not([data-drag="true"]) .PinnedTabsBar[data-overflow="start"]
  mask-image: linear-gradient(180deg, transparent 0, #000 var(--pt-fade), #000 100%)
#root[data-pinned-tabs-position="left"]:not([data-drag="true"]) .PinnedTabsBar[data-overflow="end"]
#root[data-pinned-tabs-position="right"]:not([data-drag="true"]) .PinnedTabsBar[data-overflow="end"]
#root[data-pinned-tabs-list-capped="true"]:not([data-drag="true"]) .PinnedTabsBar[data-overflow="end"]
  mask-image: linear-gradient(180deg, #000 0, #000 calc(100% - var(--pt-fade)), transparent 100%)
#root[data-pinned-tabs-position="left"]:not([data-drag="true"]) .PinnedTabsBar[data-overflow="both"]
#root[data-pinned-tabs-position="right"]:not([data-drag="true"]) .PinnedTabsBar[data-overflow="both"]
#root[data-pinned-tabs-list-capped="true"]:not([data-drag="true"]) .PinnedTabsBar[data-overflow="both"]
  mask-image: linear-gradient(180deg, transparent 0, #000 var(--pt-fade), #000 calc(100% - var(--pt-fade)), transparent 100%)
